# =========================================================================
# CONFIGURACIÓN DEL ENTORNO ECOTUC
# Plataforma de Gestión y Reporte de Microbasurales en Tucumán
# =========================================================================

# --- BACKEND (NestJS) ---
PORT=3001

# --- BASE DE DATOS (PostgreSQL 15 con extensión PostGIS) ---
# El backend requiere PostgreSQL con PostGIS para funciones espaciales (ST_X, ST_Y, ST_DWithin).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=cambiar_por_password_seguro_postgres
DB_DATABASE=ecotuc

# --- AUTENTICACIÓN JWT ---
# Clave secreta para firma de tokens JWT (usar una clave criptográficamente segura en producción)
JWT_SECRET=cambiar_por_clave_secreta_jwt_larga_y_segura_2026

# --- FRONTEND (Next.js) ---
# URL base para conexión con la API REST del backend
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# --- CONFIGURACIÓN DE MAPAS (LEAFLET) ---
# Por defecto se utiliza OpenStreetMap público (libre, sin clave de API y sin marcas de agua de "API KEY REQUIRED").
# SEGURIDAD: NO incluyas claves privadas en variables NEXT_PUBLIC_* ni en archivos versionados.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Opcional (si se utiliza un proveedor comercial que admita clave pública en la URL):
# NEXT_PUBLIC_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png?api_key=TU_CLAVE_PUBLICA
