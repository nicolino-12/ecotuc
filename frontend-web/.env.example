# =========================================================================
# CONFIGURACIÓN DEL FRONTEND WEB ECOTUC (Next.js)
# =========================================================================

# URL base para la conexión a la API REST de EcoTuc
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Configuración del proveedor de mapas (Leaflet / Teselas)
# Por defecto se utiliza OpenStreetMap público: libre, sin costo, no requiere claves privadas y no muestra "API KEY REQUIRED".
# SEGURIDAD: Nunca expongas claves de API privadas en variables NEXT_PUBLIC_* ni en el código.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
